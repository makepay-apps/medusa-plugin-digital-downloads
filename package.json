{
  "name": "@makecrypto/medusa-plugin-digital-downloads",
  "version": "0.3.0",
  "description": "Native-feeling digital products, protected downloads, streaming, entitlements, and software licenses for Medusa v2.",
  "author": "MakePay",
  "license": "MIT",
  "homepage": "https://github.com/makepay-apps/medusa-plugin-digital-downloads#readme",
  "bugs": {
    "url": "https://github.com/makepay-apps/medusa-plugin-digital-downloads/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makepay-apps/medusa-plugin-digital-downloads.git"
  },
  "files": [
    ".medusa/server",
    "docs",
    "examples",
    "openapi",
    "types",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "RELEASE.md",
    "SECURITY.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": {
      "types": "./types/workflows.d.ts",
      "default": "./.medusa/server/src/workflows/index.js"
    },
    "./.medusa/server/src/modules/*": {
      "types": "./types/modules/*.d.ts",
      "default": "./.medusa/server/src/modules/*/index.js"
    },
    "./modules/*": {
      "types": "./types/modules/*.d.ts",
      "default": "./.medusa/server/src/modules/*/index.js"
    },
    "./providers/*": {
      "types": "./types/providers/*.d.ts",
      "default": "./.medusa/server/src/providers/*/index.js"
    },
    "./storefront": {
      "types": "./.medusa/server/src/storefront/index.d.ts",
      "default": "./.medusa/server/src/storefront/index.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa-plugin",
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-other",
    "digital-products",
    "digital-downloads",
    "software-licenses",
    "protected-downloads",
    "s3",
    "makepay"
  ],
  "scripts": {
    "build": "medusa plugin:build && tsc -p tsconfig.storefront.json",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e-harness && npm run build && npm run test:packed-types && npm run pack:dry-run",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "pack:dry-run": "npm pack --dry-run --json",
    "prepublishOnly": "npm run check",
    "test": "npm run test:unit",
    "test:e2e-harness": "node scripts/e2e/test-run-command-with-timeout.mjs && node scripts/e2e/test-launch-detached.mjs",
    "test:packed-types": "node scripts/test-packed-types.mjs",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/eslint-plugin": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/icons": "2.18.0",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/test-utils": "2.18.0",
    "@medusajs/ui": "4.2.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.39",
    "@tanstack/react-query": "5.64.2",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jiti": "^2.0.0",
    "@cyclonedx/cyclonedx-npm": "6.0.0",
    "prop-types": "^15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "13.5.0",
    "react-router-dom": "6.30.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.2.11",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": ">=2.18.0 <3.0.0",
    "@medusajs/framework": ">=2.18.0 <3.0.0",
    "@medusajs/icons": ">=2.18.0 <3.0.0",
    "@medusajs/js-sdk": ">=2.18.0 <3.0.0",
    "@medusajs/medusa": ">=2.18.0 <3.0.0",
    "@medusajs/ui": ">=4.0.0 <5.0.0",
    "@tanstack/react-query": ">=5.64.0 <6.0.0",
    "react": ">=18.3.1 <20.0.0",
    "react-dom": ">=18.3.1 <20.0.0",
    "react-i18next": ">=13.5.0 <14.0.0",
    "react-router-dom": ">=6.30.0 <7.0.0"
  },
  "peerDependenciesMeta": {
    "@medusajs/admin-sdk": {
      "optional": true
    },
    "@medusajs/framework": {
      "optional": true
    },
    "@medusajs/icons": {
      "optional": true
    },
    "@medusajs/js-sdk": {
      "optional": true
    },
    "@medusajs/medusa": {
      "optional": true
    },
    "@medusajs/ui": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0"
  },
  "packageManager": "npm@10.9.3"
}
